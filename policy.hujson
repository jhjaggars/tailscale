// This tailnet's ACLs are maintained in https://github.com/jhjaggars/tailscale
// Example/default ACLs for unrestricted connections.
{
	// Declare static groups of users beyond those in the identity service.
	"groups": {
		"group:example": ["user1@example.com", "user2@example.com"],
		// Invited only to use Plane: tag:plane:443 and nothing else.
		"group:plane-users": ["akitanoek@gmail.com", "bsdmatburt@gmail.com"],
	},

	// Declare convenient hostname aliases to use in place of IP addresses.
	"hosts": {
		"example-host-1": "100.100.100.100",
	},

	// Access control lists.
	"acls": [
		// Full access only for people already on the tailnet before Plane was shared.
		// Was users: ["*"], which would give every newly invited member the whole tailnet
		// and bee's 192.168.1.0/24 subnet route. Do NOT add invitees here.
		{
			"action": "accept",
			"users":  ["jhjaggars@gmail.com", "abays113@yahoo.com"],
			"ports":  ["*:*"],
		},
		// Plane's own tailnet node (Tailscale operator Ingress, homelab clusters/homelab/plane).
		{"action": "accept", "users": ["group:plane-users"], "ports": ["tag:plane:443"]},
		// openclaw-shared lab VM (homelab plans/openclaw-shared-lab-vm.md). The VM is an UNTAGGED
		// device owned by the agent identity below (tagged devices cannot be node-shared). That
		// identity appears in NO rule as a source, so the VM can initiate nothing -- keep it that way;
		// never add it to the full-access list above. jhjaggars/abays113 already reach it via *:*.
		// autogroup:shared = whoever accepted the node share (the friend): SSH only.
		{"action": "accept", "users": ["autogroup:shared"], "ports": ["jhjaggars.agent@gmail.com:22"]},
	],
	"ssh": [
		// Allow all users to SSH into their own devices in check mode.
		// Comment this section out if you want to define specific restrictions.
		{
			"action": "check",
			"src":    ["autogroup:members"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],
	// Blocking assertions: PR check fails if the lab VM's identity could reach the rest of the tailnet.
	// 100.76.50.5 = bee (also advertises 192.168.1.0/24), 100.74.245.120 = csb-vm.
	"tests": [
		{"src": "jhjaggars@gmail.com", "accept": ["jhjaggars.agent@gmail.com:22"]},
		{"src": "jhjaggars.agent@gmail.com", "deny": ["100.76.50.5:22", "100.76.50.5:18789", "100.74.245.120:22", "192.168.1.58:22", "192.168.1.1:443"]},
		{"src": "bsdmatburt@gmail.com", "deny": ["jhjaggars.agent@gmail.com:22"]},
	],
	"tagOwners": {
		"tag:k8s-operator": [],
		"tag:k8s": ["tag:k8s-operator"],
		"tag:plane": ["tag:k8s-operator"],
	}
}
