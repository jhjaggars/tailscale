// This tailnet's ACLs are maintained in https://github.com/jhjaggars/tailscale
// Example/default ACLs for unrestricted connections.
{
	// Declare static groups of users beyond those in the identity service.
	"groups": {
		"group:example": ["user1@example.com", "user2@example.com"],
		// Invited only to use Plane: tag:plane:443 and nothing else.
		"group:plane-users": ["akitanoek@gmail.com"],
	},

	// Declare convenient hostname aliases to use in place of IP addresses.
	"hosts": {
		"example-host-1": "100.100.100.100",
	},

	// Access control lists.
	"acls": [
		// Full access only for people already on the tailnet before Plane was shared.
		// Was users: ["*"], which would give every newly invited member the whole tailnet
		// and bee's 192.168.1.0/24 subnet route. Do NOT add invitees here.
		{
			"action": "accept",
			"users":  ["jhjaggars@gmail.com", "bsdmatburt@gmail.com", "abays113@yahoo.com"],
			"ports":  ["*:*"],
		},
		// Plane's own tailnet node (Tailscale operator Ingress, homelab clusters/homelab/plane).
		{"action": "accept", "users": ["group:plane-users"], "ports": ["tag:plane:443"]},
	],
	"ssh": [
		// Allow all users to SSH into their own devices in check mode.
		// Comment this section out if you want to define specific restrictions.
		{
			"action": "check",
			"src":    ["autogroup:members"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
		{
			// Alice can use Tailscale SSH to connect to devices with tag:prod as root user using check mode, with a check period of 1 hour
			"action": "check",
			"src": ["james.laska@gmail.com"],
			"dst": ["octopi"],
			"users": ["jlaska"],
			"checkPeriod": "1h"
		}
	],
	"tagOwners": {
		"tag:k8s-operator": [],
		"tag:k8s": ["tag:k8s-operator"],
		"tag:plane": ["tag:k8s-operator"],
	}
}
